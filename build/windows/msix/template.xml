<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="server-manager"
        Arguments=""
        InstallLocation="C:\Program Files\Server Manager">
    </Installer>
    <PackageInformation
        PackageName="Server Manager"
        PackageDisplayName="Server Manager"
        PublisherName="CN=Server Manager"
        PublisherDisplayName="Server Manager contributors"
        Version="0.1.0.0"
        PackageDescription="A server-manager application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.servermanager.app"
                Description="A server-manager application"
                DisplayName="Server Manager"
                ExecutableName="server-manager"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Server Manager</DisplayName>
            <PublisherDisplayName>Server Manager contributors</PublisherDisplayName>
            <Description>A server-manager application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="server-manager.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
