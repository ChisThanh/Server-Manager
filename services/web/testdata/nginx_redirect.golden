# sm-meta: {"v":1,"spec":{"engine":"nginx","domains":["old.example.com"],"type":"redirect","upstreams":[],"lbMethod":"","webSocket":false,"connectTimeout":0,"readTimeout":0,"sendTimeout":0,"requestHeaders":[],"root":"","index":"","spa":false,"redirectTo":"https://new.example.com/","redirectCode":308,"preservePath":true,"ssl":"none","certName":"","certPath":"","keyPath":"","email":"","keyType":"","staging":false,"forceHttps":false,"http2":false,"hsts":false,"hstsMaxAge":0,"hstsSubdomains":false,"responseHeaders":[],"maxBodyMb":0,"gzip":false,"rateLimit":false,"rateRps":0,"rateBurst":0,"rateNoDelay":false,"basicAuth":false,"authRealm":"","authUsers":[],"accessLog":"","errorLog":"","extra":""}}
# Generated by Server Manager. Edit this site in the app: manual changes are replaced when it is saved again.

server {
	listen 80;
	listen [::]:80;
	server_name old.example.com;

	# Let's Encrypt HTTP-01 challenges (issuance and renewal without stopping nginx)
	location ^~ /.well-known/acme-challenge/ {
		root /var/www/letsencrypt;
		default_type "text/plain";
		try_files $uri =404;
	}

	access_log "/var/log/nginx/old.example.com.access.log";
	error_log "/var/log/nginx/old.example.com.error.log";

	location / {
		return 308 "https://new.example.com$request_uri";
	}
}
