# managed-by: server-manager
# sm-meta: {"v":1,"spec":{"engine":"caddy","domains":["app.example.com","www.app.example.com"],"type":"proxy","upstreams":["127.0.0.1:3000","127.0.0.1:3001"],"lbMethod":"ip_hash","webSocket":false,"connectTimeout":0,"readTimeout":60,"sendTimeout":0,"requestHeaders":[{"name":"X-Real-IP","value":"{remote_host}"}],"root":"","index":"","spa":false,"redirectTo":"","redirectCode":0,"preservePath":false,"ssl":"letsencrypt","certName":"","certPath":"","keyPath":"","email":"ops@example.com","keyType":"","staging":false,"forceHttps":false,"http2":false,"hsts":true,"hstsMaxAge":31536000,"hstsSubdomains":false,"responseHeaders":[],"maxBodyMb":10,"gzip":true,"rateLimit":false,"rateRps":0,"rateBurst":0,"rateNoDelay":false,"basicAuth":true,"authRealm":"Restricted","authUsers":[{"user":"alice"}],"accessLog":"","errorLog":"","extra":""}}
# Generated by Server Manager. Edit this site in the app: manual changes are replaced when it is saved again.

app.example.com, www.app.example.com {
	tls ops@example.com
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
	}
	request_body {
		max_size 10MB
	}
	basicauth {
		alice $2a$12$abcdefghijklmnopqrstuuMqL6vH4aF6T5Yb0yJ1sZ2u3v4w5x6y7z
	}
	log {
		output file "/var/log/caddy/app.example.com.access.log"
	}

	reverse_proxy 127.0.0.1:3000 127.0.0.1:3001 {
		lb_policy ip_hash
		header_up X-Real-IP "{remote_host}"
		transport http {
			read_timeout 60s
		}
	}
}
