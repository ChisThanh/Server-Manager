# sm-meta: {"v":1,"spec":{"engine":"nginx","domains":["*.example.org"],"type":"proxy","upstreams":["http://127.0.0.1:3000"],"lbMethod":"","webSocket":false,"connectTimeout":0,"readTimeout":0,"sendTimeout":0,"requestHeaders":[],"root":"","index":"","spa":false,"redirectTo":"","redirectCode":0,"preservePath":false,"ssl":"custom","certName":"","certPath":"/etc/ssl/server-manager/wild/fullchain.pem","keyPath":"/etc/ssl/server-manager/wild/privkey.pem","email":"","keyType":"","staging":false,"forceHttps":false,"http2":true,"hsts":false,"hstsMaxAge":0,"hstsSubdomains":false,"responseHeaders":[],"maxBodyMb":0,"gzip":false,"rateLimit":false,"rateRps":0,"rateBurst":0,"rateNoDelay":false,"basicAuth":false,"authRealm":"","authUsers":[],"accessLog":"","errorLog":"","extra":""}}
# Generated by Server Manager. Edit this site in the app: manual changes are replaced when it is saved again.

server {
	listen 80;
	server_name *.example.org;

	# Let's Encrypt HTTP-01 challenges (issuance and renewal without stopping nginx)
	location ^~ /.well-known/acme-challenge/ {
		root /var/www/letsencrypt;
		default_type "text/plain";
		try_files $uri =404;
	}

	access_log "/var/log/nginx/wildcard.example.org.access.log";
	error_log "/var/log/nginx/wildcard.example.org.error.log";

	location / {
		proxy_pass "http://127.0.0.1:3000";
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $host;
	}
}

server {
	listen 443 ssl;
	http2 on;
	server_name *.example.org;

	ssl_certificate "/etc/ssl/server-manager/wild/fullchain.pem";
	ssl_certificate_key "/etc/ssl/server-manager/wild/privkey.pem";
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_session_timeout 1d;

	access_log "/var/log/nginx/wildcard.example.org.access.log";
	error_log "/var/log/nginx/wildcard.example.org.error.log";

	location / {
		proxy_pass "http://127.0.0.1:3000";
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $host;
	}
}
