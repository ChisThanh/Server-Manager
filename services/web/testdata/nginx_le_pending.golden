# managed-by: server-manager
# sm-meta: {"v":1,"spec":{"engine":"nginx","domains":["app.example.com","www.app.example.com"],"type":"proxy","upstreams":["http://127.0.0.1:3000"],"lbMethod":"","webSocket":false,"connectTimeout":0,"readTimeout":0,"sendTimeout":0,"requestHeaders":[],"root":"","index":"","spa":false,"redirectTo":"","redirectCode":0,"preservePath":false,"ssl":"letsencrypt","certName":"app.example.com","certPath":"","keyPath":"","email":"ops@example.com","keyType":"ecdsa","staging":false,"forceHttps":true,"http2":false,"hsts":false,"hstsMaxAge":0,"hstsSubdomains":false,"responseHeaders":[],"maxBodyMb":0,"gzip":false,"rateLimit":false,"rateRps":0,"rateBurst":0,"rateNoDelay":false,"basicAuth":false,"authRealm":"","authUsers":[],"accessLog":"","errorLog":"","extra":""}}
# Generated by Server Manager. Edit this site in the app: manual changes are replaced when it is saved again.

server {
	listen 80;
	listen [::]:80;
	server_name app.example.com www.app.example.com;

	# Let's Encrypt HTTP-01 challenges (issuance and renewal without stopping nginx)
	location ^~ /.well-known/acme-challenge/ {
		root /var/www/letsencrypt;
		default_type "text/plain";
		try_files $uri =404;
	}

	access_log "/var/log/nginx/app.example.com.access.log";
	error_log "/var/log/nginx/app.example.com.error.log";

	location / {
		proxy_pass "http://127.0.0.1:3000";
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $host;
	}
}
