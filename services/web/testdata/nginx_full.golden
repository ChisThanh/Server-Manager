# managed-by: server-manager
# sm-meta: {"v":1,"spec":{"engine":"nginx","domains":["app.example.com","www.app.example.com"],"type":"proxy","upstreams":["http://10.0.0.1:8080","http://10.0.0.2:8080","unix:/run/app.sock"],"lbMethod":"least_conn","webSocket":true,"connectTimeout":5,"readTimeout":120,"sendTimeout":0,"requestHeaders":[{"name":"X-App","value":"say \"hi\""},{"name":"Host","value":"internal.example"}],"root":"","index":"","spa":false,"redirectTo":"","redirectCode":0,"preservePath":false,"ssl":"letsencrypt","certName":"app.example.com","certPath":"","keyPath":"","email":"ops@example.com","keyType":"ecdsa","staging":false,"forceHttps":true,"http2":true,"hsts":true,"hstsMaxAge":31536000,"hstsSubdomains":true,"responseHeaders":[{"name":"X-Frame-Options","value":"DENY"}],"maxBodyMb":50,"gzip":true,"rateLimit":true,"rateRps":20,"rateBurst":40,"rateNoDelay":true,"basicAuth":true,"authRealm":"Restricted","authUsers":[{"user":"alice"}],"accessLog":"off","errorLog":"/var/log/nginx/custom-error.log","extra":"location /healthz {\n    return 200 'ok';\n}"}}
# Generated by Server Manager. Edit this site in the app: manual changes are replaced when it is saved again.

upstream sm_up_app_example_com_280598 {
	least_conn;
	server 10.0.0.1:8080;
	server 10.0.0.2:8080;
	server "unix:/run/app.sock";
	keepalive 16;
}

server {
	listen 80;
	listen [::]:80;
	server_name app.example.com www.app.example.com;

	# Let's Encrypt HTTP-01 challenges (issuance and renewal without stopping nginx)
	location ^~ /.well-known/acme-challenge/ {
		root /var/www/letsencrypt;
		default_type "text/plain";
		auth_basic off;
		try_files $uri =404;
	}

	location / {
		return 301 https://$host$request_uri;
	}
}

server {
	listen 443 ssl http2;
	listen [::]:443 ssl http2;
	server_name app.example.com www.app.example.com;

	ssl_certificate "/etc/letsencrypt/live/app.example.com/fullchain.pem";
	ssl_certificate_key "/etc/letsencrypt/live/app.example.com/privkey.pem";
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_session_timeout 1d;
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

	access_log off;
	error_log "/var/log/nginx/custom-error.log";
	client_max_body_size 50m;
	gzip on;
	gzip_vary on;
	gzip_proxied any;
	gzip_comp_level 5;
	gzip_min_length 256;
	gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/rss+xml application/wasm image/svg+xml;
	auth_basic "Restricted";
	auth_basic_user_file "/etc/nginx/htpasswd/app.example.com";
	limit_req zone=sm_rl_app_example_com_280598 burst=40 nodelay;
	limit_req_status 429;
	add_header X-Frame-Options "DENY" always;

	# Extra directives
	location /healthz {
	    return 200 'ok';
	}

	location / {
		proxy_pass "http://sm_up_app_example_com_280598";
		proxy_http_version 1.1;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $sm_connection_upgrade;
		proxy_set_header X-App "say \"hi\"";
		proxy_set_header Host "internal.example";
		proxy_connect_timeout 5s;
		proxy_read_timeout 120s;
		proxy_send_timeout 3600s;
	}
}

### /etc/nginx/conf.d/sm-ratelimit-app.example.com.conf
# managed-by: server-manager
# Rate limit zone for app.example.com
limit_req_zone $binary_remote_addr zone=sm_rl_app_example_com_280598:10m rate=20r/s;

### /etc/nginx/conf.d/sm-websocket-map.conf
# managed-by: server-manager
# WebSocket upgrade map shared by the sites managed by Server Manager.
map $http_upgrade $sm_connection_upgrade {
	default upgrade;
	''      close;
}
