# managed-by: server-manager
# sm-meta: {"v":1,"spec":{"engine":"nginx","domains":["static.example.com"],"type":"static","upstreams":[],"lbMethod":"","webSocket":false,"connectTimeout":0,"readTimeout":0,"sendTimeout":0,"requestHeaders":[],"root":"/var/www/static","index":"index.html index.htm","spa":true,"redirectTo":"","redirectCode":0,"preservePath":false,"ssl":"none","certName":"","certPath":"","keyPath":"","email":"","keyType":"","staging":false,"forceHttps":false,"http2":false,"hsts":false,"hstsMaxAge":0,"hstsSubdomains":false,"responseHeaders":[],"maxBodyMb":0,"gzip":true,"rateLimit":false,"rateRps":0,"rateBurst":0,"rateNoDelay":false,"basicAuth":false,"authRealm":"","authUsers":[],"accessLog":"","errorLog":"","extra":""}}
# Generated by Server Manager. Edit this site in the app: manual changes are replaced when it is saved again.

server {
	listen 80;
	server_name static.example.com;

	# Let's Encrypt HTTP-01 challenges (issuance and renewal without stopping nginx)
	location ^~ /.well-known/acme-challenge/ {
		root /var/www/letsencrypt;
		default_type "text/plain";
		try_files $uri =404;
	}

	access_log "/var/log/nginx/static.example.com.access.log";
	error_log "/var/log/nginx/static.example.com.error.log";
	gzip on;
	gzip_vary on;
	gzip_proxied any;
	gzip_comp_level 5;
	gzip_min_length 256;
	gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/rss+xml application/wasm image/svg+xml;

	root "/var/www/static";
	index index.html index.htm;
	location / {
		try_files $uri $uri/ /index.html;
	}
}
